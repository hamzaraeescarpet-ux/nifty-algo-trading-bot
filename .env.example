# Trading Bot Environment Variables
# Copy this file to .env and fill in your details

# Mode: "PAPER" or "LIVE"
TRADING_MODE=PAPER

# Capital & Risk Settings
INITIAL_CAPITAL=100000.0
RISK_PER_TRADE_PERCENT=1.0
MAX_DAILY_LOSS_PERCENT=2.0
MAX_OPEN_POSITIONS=3
RISK_REWARD_RATIO=2.0

# Kotak Neo API Credentials (Jab real live trading karni ho)
KOTAK_CONSUMER_KEY=your_consumer_key_here
KOTAK_CONSUMER_SECRET=your_consumer_secret_here
KOTAK_MOBILE_NUMBER=your_registered_mobile
KOTAK_PASSWORD=your_password
KOTAK_MPIN=your_mpin
KOTAK_TOTP_KEY=your_totp_secret_key
KOTAK_ENVIRONMENT=prod
